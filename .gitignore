
# ==========================================
# VOLTIX STORE - Nuxt 3 Git Ignore
# ==========================================

# Dependencies
node_modules/
.pnpm-store/

# Nuxt generated files
.nuxt/
.output/
.data/
.cache/
dist/

# Build and deployment
.vercel/
.netlify/
.temp/
.tmp/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE and editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# TypeScript
*.tsbuildinfo

# Testing and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Local database files
*.sqlite
*.sqlite3
*.db

# Temporary files
*.tmp
*.temp
*.bak

# Local secrets and credentials
*.pem
*.key
*.p12
*.pfx
service-account*.json

# Supabase local development
supabase/.branches/
supabase/.temp/

# Miscellaneous
*.local
